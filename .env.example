# Local HTTP only. Use production behind HTTPS for an Internet deployment.
NODE_ENV=development
APP_PORT=3000
PORT=3000
# Keep 0 for direct local access; set 1 behind the supplied trusted Nginx proxy.
TRUST_PROXY_HOPS=0

# The compose file supplies the Redis service address.
REDIS_URL=redis://127.0.0.1:6379
SESSION_TTL_SECONDS=86400
COOKIE_NAME=atrium_session

# S3-compatible provider; enter login credentials in the administration UI.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_SIZE_MB=2048

# Enable sharing for one bucket. This must match a real, existing bucket.
SHARE_BUCKET=
# Same origin is sufficient; a separate public hostname is optional.
SHARE_BASE_URL=http://localhost:3000
# Optional override for the hostname of generated /c/ and /s/ links.
DL_BASE_URL=
# SHA-256 of the administrator's login Access Key ID (not the reader's ID).
# Run: node scripts/share-owner-hash.mjs
SHARE_OWNER_HASH=
# Compose overrides this path to its read-only /run/secrets mount.
SHARE_READER_CREDENTIALS_FILE=./secrets/share-reader.json
# Only for deployments deliberately using an existing public object source.
# Keep blank when using the recommended authenticated S3 reader.
SHARE_SOURCE_URL=

# Paths below are convenient when running Node directly; compose overrides them.
SHARE_DB_PATH=./data/shares.sqlite
SHARE_STORE_PATH=./data/shares.json
SHORT_LINK_STORE=./data/shortlinks.json
UPLOAD_STORE_PATH=./data/uploads.sqlite
OBJECT_INDEX_PATH=./data/objects.sqlite
MEDIA_CACHE_DIR=./data/media-cache
ARCHIVE_DIR=./data/archives

# Listing and storage-size indexing
S3_LIST_CACHE_ENABLED=true
S3_LIST_CACHE_TTL_SECONDS=300
S3_LIST_CACHE_INVALIDATION_MODE=targeted
S3_LIST_CACHE_INCLUDE_HEADERS=true
BUCKET_SIZE_CALC_INTERVAL_HOURS=1
BUCKET_SIZE_MAX_DURATION_MS=300000
BUCKET_SIZE_MAX_OBJECTS=1000000
ENABLE_S3_URI_COPY=false

# Optional audit log output. This directory should be persisted.
AUDIT_LOG_SINK=filesystem
AUDIT_LOG_DIR=./audit-logs
AUDIT_LOG_RETENTION_DAYS=30
AUDIT_LOG_LOKI_URL=

# Optional observability integrations. Empty DSNs disable remote Sentry reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=atrium-share@0.2.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLE_LOGS=false
SENTRY_ENABLE_METRICS=false
FRONTEND_SENTRY_DSN=
FRONTEND_SENTRY_ENVIRONMENT=development
FRONTEND_SENTRY_RELEASE=atrium-share@0.2.0
FRONTEND_SENTRY_TRACES_SAMPLE_RATE=0.1
FRONTEND_SENTRY_ENABLE_LOGS=false
FRONTEND_SENTRY_ENABLE_METRICS=false
FRONTEND_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
FRONTEND_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
